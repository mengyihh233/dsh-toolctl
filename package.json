{
  "name": "dsh-toolctl",
  "version": "0.1.0",
  "description": "DSH 工具控制插件：会话头部按钮开关 AI 可见工具（隐藏的工具不注入模型请求，省 token）+ 设置页选项卡滚动补丁",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tool-control",
    "token",
    "optimizer"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "prepare": "node scripts/setup-dsh-links.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "build": "npm run build:host && npm run build:client",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0"
  }
}
